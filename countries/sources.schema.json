{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tereshed/8bitnews/countries/sources.schema.json",
  "title": "8bitnews country sources profile",
  "description": "Schema for countries/<cc>/sources.yaml. The literal string \"tbd\" is a valid placeholder for any string field until the value is filled in (see --strict mode of cmd/profiles).",
  "type": "object",
  "additionalProperties": false,
  "required": ["country", "language", "local", "world", "primary", "pollsters"],
  "$defs": {
    "outlet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outlet", "domain"],
      "properties": {
        "outlet": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "leaning": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "ownership": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "country": {
      "type": "string",
      "minLength": 1,
      "description": "Country code; must correspond to the directory under countries/ (case-insensitive)."
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "local": {
      "type": "array",
      "items": { "$ref": "#/$defs/outlet" }
    },
    "world": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region", "outlets"],
        "properties": {
          "region": { "type": "string", "minLength": 1 },
          "outlets": {
            "type": "array",
            "items": { "$ref": "#/$defs/outlet" }
          }
        }
      }
    },
    "primary": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "pollsters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "domain"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
