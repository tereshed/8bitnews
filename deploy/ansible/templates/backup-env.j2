# Managed by deploy/ansible/hub_backup.yml. root-only. Restic repository
# (backups bucket) + the same R2 credential pair used for the media
# bucket in {{ hub_env_file }} — one R2 token scoped to both buckets.
RESTIC_REPOSITORY={{ restic_repository }}
RESTIC_PASSWORD={{ restic_password }}
AWS_ACCESS_KEY_ID={{ r2_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ r2_secret_access_key }}
