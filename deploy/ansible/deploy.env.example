# Copy to ~/.config/8bitnews/deploy.env (chmod 600) and fill in real values.
# `make deploy-hub-vm` / `make deploy-hub` / `make deploy-hub-backup` source
# this file and pass it straight to ansible-playbook as the controller's
# environment — these values are never written into this repository.
# See docs/deploy.md for where each value comes from.

# --- Server ---
HUB_SERVER_HOST=135.181.4.110
# Only needed if the host's default route isn't its public interface.
HUB_SERVER_PUBLIC_IP=

# --- Domain + the admin key for the guest VM's only user ---
HUB_DOMAIN=
HUB_ADMIN_SSH_PUBLIC_KEY=

# --- Git ref deployed into the guest (make deploy-hub REF=<ref> overrides this) ---
HUB_REF=main

# --- Cloudflare R2: media bucket (internal/storage) ---
HUB_S3_ENDPOINT=
HUB_S3_BUCKET=
HUB_S3_ACCESS_KEY=
HUB_S3_SECRET_KEY=
HUB_S3_REGION=auto

# --- Cloudflare R2: backups bucket + restic ---
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
HUB_BACKUP_S3_ACCESS_KEY=
HUB_BACKUP_S3_SECRET_KEY=
