# Copy to ~/.config/8bitnews/deploy.env (chmod 600) and fill in real values.
# `make deploy-hub-vm` / `make deploy-hub` / `make deploy-hub-backup` source
# this file and pass it straight to ansible-playbook as the controller's
# environment — these values are never written into this repository.
# See docs/deploy.md for where each value comes from.

# --- Server ---
HUB_SERVER_HOST=135.181.4.110
# Only needed if the host's default route isn't its public interface.
HUB_SERVER_PUBLIC_IP=

# --- Domain ---
# Already hub.8bitlang.org with an existing A-record to 135.181.4.110
# (Cloudflare, "DNS only") — only set this to override it.
HUB_DOMAIN=

# --- SSH private keys (paths, not the key material itself) ---
# HUB_SERVER_SSH_KEY: the operator's own key that root@135.181.4.110 (the
# neighbor's server) already trusts — used both to reach the host directly
# and as the -i key of the ProxyCommand hop used to reach the guest.
# HUB_ADMIN_SSH_KEY: a *separate* key pair for the guest VM's one admin
# user. Only the private half is set here — hub_vm.yml derives the public
# half (ssh-keygen -y) and injects it via cloud-init, so there's nothing
# else to keep in sync.
HUB_SERVER_SSH_KEY=
HUB_ADMIN_SSH_KEY=

# --- Git ref deployed into the guest (make deploy-hub REF=<ref> overrides this) ---
HUB_REF=main

# --- Cloudflare R2, EU jurisdiction: one token/credential pair scoped to
# --- both buckets below. Endpoint shape: https://<account_id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=8bitnews-media
R2_BACKUP_BUCKET=8bitnews-backups

# --- restic (backups bucket); the repository URL is derived from
# --- R2_ENDPOINT + R2_BACKUP_BUCKET, only the encryption password is set here ---
RESTIC_PASSWORD=

# --- Telegram moderation (E4): the bot that posts each release to the
# --- moderation group, and that group's chat id (a negative number for a
# --- group). The group's administrators are the moderators. Leave the token
# --- empty to keep the bot off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODERATION_CHAT_ID=
