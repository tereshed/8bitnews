    "style": {
      "color": "#f8f8f8",
      "outline_color": "#000000",
      "max_lines": 2,
      "max_chars_per_line": 23
    }
  },
  "timing": {
    "scene_pause_s": 0.3
  },
  "motion_presets": [
    {
      "id": "slow-pan",
      "type": "pan",
      "params": {
        "dx_px": 12,
        "dy_px": 0,
        "duration_s": 4.0
      }
    },
    {
      "id": "slow-zoom",
      "type": "zoom",
      "params": {
        "max_px": 12,
        "duration_s": 4.0
      }
    },
    {
      "id": "parallax-default",
      "type": "parallax",
      "params": {
        "layer_indices": [
          0,
          1
        ],
        "shift_px": 4
      }
    },
    {
      "id": "title-appear",
      "type": "element_appear",
      "params": {
        "element": "scene_title",
        "delay_s": 0.2
      }
    }
  ],
  "transitions": [
    {
      "id": "cut",
      "type": "cut",
      "duration_s": 0.0,
      "sound": null
    },
    {
      "id": "slow-slide",
      "type": "slide",
      "duration_s": 0.6,
      "sound": null
    }
  ],
  "cover": {
    "layout": {
      "background": "assets/sample_scene.png",
      "text_rect": {
        "x": 10,
        "y": 322,
        "w": 190,
        "h": 32
