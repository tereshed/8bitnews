{
  "id": "night-report",
  "name": "Night Report",
  "version": 1,
  "image_style": "Night-time scenes in dark blue, teal and grey tones with a few lit windows or lamps.",
  "license_note": "All PNG assets in assets/ are original placeholder pixel art drawn for this repository (studio/scripts/generate_assets.py); no third-party material.",
  "studio": {
    "layers": [
      {
        "file": "assets/background_layer0.png",
        "x": 0,
        "y": 0,
        "parallax": 0
      },
      {
        "file": "assets/desk.png",
        "x": 0,
        "y": 0,
        "parallax": 0,
        "front": true
      }
    ],
    "anchor": {
      "x": 75,
      "y": 196,
      "scale": 1
    },
    "screen": {
      "x": 50,
      "y": 70,
      "w": 170,
      "h": 136,
      "border_color": "#000000"
    }
  },
  "palette": {
    "colors": [
      "#000000",
      "#004058",
      "#787878",
      "#7c7c7c",
      "#008888",
      "#f8f8f8",
      "#bcbcbc"
    ],
    "serious_colors": [
      "#000000",
      "#004058",
      "#787878",
      "#7c7c7c",
      "#008888",
      "#f8f8f8"
    ]
  },
  "plates": {
    "ai_label": {
      "y": 380,
      "text_color": "#bcbcbc",
      "outline_color": "#000000"
    },
    "source_plate": {
      "rect": {
        "x": 40,
        "y": 40,
        "w": 190,
        "h": 32
      },
      "bg_color": "#000000",
      "text_color": "#bcbcbc",
      "max_lines": 3
    },
    "scene_title": {
      "rect": {
        "x": 40,
        "y": 40,
        "w": 190,
        "h": 22
      },
      "bg_color": "#000000",
      "text_color": "#f8f8f8",
      "max_lines": 2,
      "below": "source_plate"
    }
  },
  "subtitles": {
    "rect": {
      "x": 20,
      "y": 332,
      "w": 230,
      "h": 44
    },
    "style": {
      "color": "#f8f8f8",
      "outline_color": "#000000",
      "bg_color": "#000000",
      "font_scale": 2,
      "max_lines": 2,
      "max_chars_per_line": 12
    }
  },
  "timing": {
    "scene_pause_s": 0.3
  },
  "motion_presets": [
    {
      "id": "slow-pan",
      "type": "pan",
      "params": {
        "dx_px": 12,
        "dy_px": 0,
        "duration_s": 4.0
      }
    },
    {
      "id": "slow-zoom",
      "type": "zoom",
      "params": {
        "max_px": 12,
        "duration_s": 4.0
      }
    },
    {
      "id": "parallax-default",
      "type": "parallax",
      "params": {
        "layer_indices": [
          0,
          1
        ],
        "shift_px": 4
      }
    },
    {
      "id": "title-appear",
      "type": "element_appear",
      "params": {
        "element": "scene_title",
        "delay_s": 0.2
      }
    }
  ],
  "transitions": [
    {
      "id": "cut",
      "type": "cut",
      "duration_s": 0.0,
      "sound": null
    },
    {
      "id": "slow-slide",
      "type": "slide",
      "duration_s": 0.6,
      "sound": null
    }
  ],
  "cover": {
    "layout": {
      "background": "assets/sample_scene.png",
      "text_rect": {
        "x": 20,
        "y": 332,
        "w": 230,
        "h": 44
      }
    }
  },
  "fit": {
    "serious_mode": "required",
    "moods": [
      "somber",
      "neutral"
    ],
    "tags": [
      "night",
      "serious",
      "studio"
    ]
  },
  "assets": [
    "assets/background_layer0.png",
    "assets/desk.png",
    "assets/screen_frame.png",
    "assets/sample_scene.png"
  ]
}
