    },
    "source_plate": {
      "rect": {
        "x": 10,
        "y": 89,
        "w": 190,
        "h": 32
      },
      "bg_color": "#000000",
      "text_color": "#7c7c7c",
      "max_lines": 3
    }
  },
  "subtitles": {
    "rect": {
      "x": 10,
      "y": 320,
      "w": 190,
      "h": 32
