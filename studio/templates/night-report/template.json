      "bg_color": "#000000",
      "text_color": "#f8f8f8"
    },
    "scene_title": {
      "rect": {
        "x": 10,
        "y": 49,
        "w": 190,
        "h": 36
      },
      "bg_color": "#000000",
      "text_color": "#f8f8f8",
