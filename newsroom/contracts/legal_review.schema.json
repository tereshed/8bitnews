{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "legal_review",
  "description": "legal_lead output and final result of the Legal team.",
  "type": "object",
  "required": [
    "mode",
    "channel_id",
    "country",
    "verdict",
    "platforms",
    "issues",
    "required_disclosures",
    "summary_ru",
    "checked_against"
  ],
  "properties": {
    "mode": {
      "enum": [
        "script",
        "final"
      ],
      "description": "script: before render; final: rendered video_package"
    },
    "channel_id": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "verdict": {
      "enum": [
        "pass",
        "fix_required",
        "kill"
      ]
    },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "pass",
              "fix_required",
              "exclude"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "description": "Per enabled platform; exclude = do not publish there"
    },
    "issues": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/risk_issue"
          },
          {
            "properties": {
              "resolved_by_exclusion": {
                "type": "boolean",
                "description": "The risk exists only on platforms marked exclude"
              }
            }
          }
        ]
      }
    },
    "required_disclosures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disclosure"
      }
    },
    "kill_reason": {
      "type": "string",
      "minLength": 10
    },
    "summary_ru": {
      "type": "string",
      "minLength": 20,
      "description": "For the human moderator, Russian, <= 80 words"
    },
    "checked_against": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publish_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Instructions for the moderator and the publisher at release (no paid promotion, platform AI flags, cover frame): not issues, they block nothing"
    },
    "final_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "script mode: what only the rendered video can show and Legal final must verify (plates rendered, track, cover): not issues, they block nothing"
    },
    "video_package": {
      "type": "string",
      "minLength": 1,
      "description": "final mode: id of the video_package artifact reviewed (the video_package_id newsroom/tools/video_review_kit.py printed); release_submit refuses a review of another build"
    }
  },
  "$defs": {
    "risk_issue": {
      "type": "object",
      "required": [
        "id",
        "family",
        "severity",
        "scope",
        "where",
        "excerpt",
        "rule",
        "scenario",
        "fix",
        "fix_owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[RPX][0-9]+$",
          "description": "R* from law_report, P* from platform_report, X* added by legal_lead"
        },
        "family": {
          "enum": [
            "defamation",
            "privacy",
            "minors",
            "criminal_case",
            "likeness",
            "election",
            "copyright",
            "music",
            "ai_disclosure",
            "regulatory",
            "platform_guidelines",
            "monetization",
            "reach",
            "metadata",
            "other"
          ]
        },
        "severity": {
          "enum": [
            "blocker",
            "high",
            "medium",
            "low"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 2,
          "description": "Jurisdiction (US, US-CA, ES, EU) or platform (youtube, tiktok, instagram)"
        },
        "where": {
          "type": "string",
          "minLength": 1,
          "description": "Scene id, script or package field, or timecode"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "description": "Exact text, or a description of the visual or audio element"
        },
        "rule": {
          "type": "object",
          "required": [
            "ref",
            "summary"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 3,
              "description": "Knowledge base section (countries/us/legal.md#defamation) or official URL"
            },
            "summary": {
              "type": "string",
              "minLength": 10
            }
          }
        },
        "scenario": {
          "type": "string",
          "minLength": 10,
          "description": "Who could do what: lawsuit, fine, strike, removal, demonetization, reach limit"
        },
        "fix": {
          "type": "string",
          "minLength": 5,
          "description": "Concrete rewording or action; 'none' only for low severity"
        },
        "fix_owner": {
          "enum": [
            "script",
            "video",
            "editor",
            "none"
          ]
        }
      }
    },
    "disclosure": {
      "type": "object",
      "required": [
        "scope",
        "what"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 2,
          "description": "Platform or jurisdiction that requires it"
        },
        "what": {
          "type": "string",
          "minLength": 5,
          "description": "Flag, label or text, and where it goes"
        },
        "ref": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "final"
          }
        }
      },
      "then": {
        "required": [
          "video_package"
        ]
      },
      "description": "A final review names the build it looked at"
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "kill"
          }
        }
      },
      "then": {
        "required": [
          "kill_reason"
        ]
      }
    },
    {
      "if": {
        "required": [
          "issues"
        ],
        "properties": {
          "issues": {
            "contains": {
              "properties": {
                "severity": {
                  "enum": [
                    "blocker",
                    "high"
                  ]
                }
              },
              "not": {
                "required": [
                  "resolved_by_exclusion"
                ],
                "properties": {
                  "resolved_by_exclusion": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "enum": [
              "fix_required",
              "kill"
            ]
          }
        }
      },
      "description": "An open blocker or high issue forbids pass"
    }
  ]
}
