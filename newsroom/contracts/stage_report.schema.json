{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stage_report",
  "description": "Newsroom producer output: what another team returned in a delegation_result, so the router can choose the next stage. The router sees only artifact summaries, so the summary of this artifact carries the verdict and the ids.",
  "type": "object",
  "required": [
    "team",
    "state",
    "delegation_result_id",
    "artifacts",
    "verdict"
  ],
  "properties": {
    "team": {
      "enum": [
        "Research",
        "Script",
        "Legal",
        "Video",
        "QA"
      ]
    },
    "state": {
      "enum": [
        "done",
        "failed",
        "needs_human",
        "expired",
        "cancelled"
      ],
      "description": "State of the delegation as reported in delegation_result"
    },
    "delegation_result_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z_]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "description": "Latest artifact id per kind returned by the team, e.g. {\"research_dossier\": \"…\"}"
    },
    "verdict": {
      "enum": [
        "approved",
        "not_approved",
        "pass",
        "fix_required",
        "kill",
        "missing"
      ],
      "description": "Research/Script: approved by the team's reviewer or not; Legal: legal_review.verdict; missing: the expected artifact is absent"
    },
    "fix_owners": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "script",
          "video",
          "editor",
          "none"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Legal only: open issue ids grouped by fix_owner"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "pass",
          "fix_required",
          "exclude"
        ]
      },
      "description": "Legal only: verdict per platform"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
