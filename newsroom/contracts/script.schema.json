{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "script",
  "description": "scriptwriter output and final result of the Script team: the video script for Video, QA and Legal.",
  "type": "object",
  "required": [
    "channel_id",
    "language",
    "duration_s",
    "word_count",
    "serious_mode",
    "hook_type",
    "music",
    "scenes",
    "metadata",
    "cover"
  ],
  "properties": {
    "channel_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "dossier": {
      "type": "string",
      "description": "research_dossier artifact id or repository path"
    },
    "template": {
      "type": "string",
      "minLength": 1,
      "description": "Only when the experiment variant pins a template; otherwise omitted and Video takes the template from hub template_pick (docs/architecture.md, Templates)"
    },
    "duration_s": {
      "type": "integer",
      "minimum": 15,
      "maximum": 180,
      "description": "Planned length; the channel range is in channel.yaml"
    },
    "word_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Sum of scene word_count"
    },
    "serious_mode": {
      "type": "boolean",
      "description": "Deaths, violence, terror, disasters: see format.md"
    },
    "serious_reason": {
      "type": "string"
    },
    "hook_type": {
      "enum": [
        "new_fact",
        "number",
        "quote",
        "contrast"
      ]
    },
    "music": {
      "$ref": "#/$defs/music"
    },
    "pronunciations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "say"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "say": {
            "type": "string",
            "minLength": 1,
            "description": "Respelling, e.g. 'ess-EYE-lee'"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/scene"
      },
      "prefixItems": [
        {
          "properties": {
            "blocks": {
              "contains": {
                "const": "hook"
              }
            }
          }
        }
      ],
      "description": "In order; the first scene is the hook"
    },
    "metadata": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "youtube",
          "tiktok",
          "instagram"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/platform_meta"
      },
      "description": "Per enabled platform, by channels/<id>/metadata.md"
    },
    "cover": {
      "type": "object",
      "required": [
        "frame",
        "visual",
        "text"
      ],
      "properties": {
        "frame": {
          "type": "string",
          "pattern": "^(custom|S[0-9]+)$"
        },
        "visual": {
          "type": "string",
          "minLength": 10
        },
        "text": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": [
        "id",
        "blocks",
        "shot",
        "duration_s",
        "narration",
        "word_count",
        "on_screen_text",
        "visual",
        "real_people",
        "fact_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "hook",
              "whats_new",
              "known",
              "local",
              "world",
              "unknown",
              "outro"
            ]
          },
          "description": "Structure blocks from format.md this scene covers; merged blocks list several"
        },
        "shot": {
          "enum": [
            "anchor",
            "scene"
          ],
          "description": "anchor: the host at the studio desk; scene: a full-screen story scene"
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "narration": {
          "type": "string",
          "minLength": 1,
          "description": "Voiceover, written for the ear"
        },
        "word_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Whitespace-separated words of narration"
        },
        "on_screen_text": {
          "type": "string",
          "maxLength": 60
        },
        "source_plate": {
          "type": "string",
          "description": "Source label under a number or quote: 'Source: X · Oct 21'"
        },
        "visual": {
          "type": "string",
          "minLength": 20,
          "description": "What is on screen and what moves, English"
        },
        "real_people": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Real people shown; the template adds the 'AI illustration' plate"
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          }
        },
        "group_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^L[0-9]+$"
          }
        },
        "cluster_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^W[0-9]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "blocks": {
                "contains": {
                  "const": "whats_new"
                }
              }
            }
          },
          "then": {
            "required": [
              "fact_ids"
            ],
            "properties": {
              "fact_ids": {
                "minItems": 1
              }
            }
          },
          "description": "A 'whats_new' scene references at least one F* item"
        },
        {
          "if": {
            "properties": {
              "blocks": {
                "contains": {
                  "const": "known"
                }
              }
            }
          },
          "then": {
            "required": [
              "fact_ids"
            ],
            "properties": {
              "fact_ids": {
                "minItems": 1
              }
            }
          },
          "description": "A 'known' scene references at least one F* item"
        },
        {
          "if": {
            "properties": {
              "blocks": {
                "contains": {
                  "const": "local"
                }
              }
            }
          },
          "then": {
            "required": [
              "group_ids"
            ],
            "properties": {
              "group_ids": {
                "minItems": 1
              }
            }
          },
          "description": "A 'local' scene references at least one L* item"
        },
        {
          "if": {
            "properties": {
              "blocks": {
                "contains": {
                  "const": "world"
                }
              }
            }
          },
          "then": {
            "required": [
              "cluster_ids"
            ],
            "properties": {
              "cluster_ids": {
                "minItems": 1
              }
            }
          },
          "description": "A 'world' scene references at least one W* item"
        }
      ]
    },
    "platform_meta": {
      "type": "object",
      "required": [
        "title",
        "summary",
        "hashtags"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "description": "1-2 sentences from review.whats_new and review.known"
        },
        "hashtags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^#[A-Za-z0-9_]+$"
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "YouTube only"
        }
      }
    },
    "music": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mood": {
          "enum": [
            "neutral",
            "curious",
            "tense",
            "urgent",
            "somber",
            "hopeful"
          ],
          "description": "Mood from music/catalog.yaml"
        },
        "energy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "cue": {
          "type": "string",
          "minLength": 10,
          "description": "Where the track enters, ducks, swells and fades"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "mood",
          "energy",
          "cue"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "serious_mode": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "serious_reason"
        ],
        "properties": {
          "music": {
            "anyOf": [
              {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              },
              {
                "properties": {
                  "mood": {
                    "enum": [
                      "somber",
                      "neutral"
                    ]
                  },
                  "energy": {
                    "maximum": 2
                  }
                }
              }
            ]
          }
        }
      },
      "description": "Serious mode: no music, or a somber or neutral track at energy 1-2"
    }
  ]
}
