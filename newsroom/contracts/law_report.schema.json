{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "law_report",
  "description": "legal_counsel output: legal risks under the country's law and the channel's policy.",
  "type": "object",
  "required": [
    "mode",
    "checked_against",
    "issues",
    "required_disclosures"
  ],
  "properties": {
    "mode": {
      "enum": [
        "script",
        "final"
      ],
      "description": "script: before render; final: rendered video_package"
    },
    "checked_against": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Knowledge base files read, with their verified_at"
    },
    "issues": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/risk_issue"
          },
          {
            "properties": {
              "id": {
                "pattern": "^R[0-9]+$"
              }
            }
          }
        ]
      }
    },
    "required_disclosures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disclosure"
      }
    },
    "publish_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Instructions for the publish step (not issues; legal_lead merges them)"
    },
    "final_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "script mode: what only the rendered video can show (not issues)"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "risk_issue": {
      "type": "object",
      "required": [
        "id",
        "family",
        "severity",
        "scope",
        "where",
        "excerpt",
        "rule",
        "scenario",
        "fix",
        "fix_owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[RPX][0-9]+$",
          "description": "R* from law_report, P* from platform_report, X* added by legal_lead"
        },
        "family": {
          "enum": [
            "defamation",
            "privacy",
            "minors",
            "criminal_case",
            "likeness",
            "election",
            "copyright",
            "music",
            "ai_disclosure",
            "regulatory",
            "platform_guidelines",
            "monetization",
            "reach",
            "metadata",
            "other"
          ]
        },
        "severity": {
          "enum": [
            "blocker",
            "high",
            "medium",
            "low"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 2,
          "description": "Jurisdiction (US, US-CA, ES, EU) or platform (youtube, tiktok, instagram)"
        },
        "where": {
          "type": "string",
          "minLength": 1,
          "description": "Scene id, script or package field, or timecode"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "description": "Exact text, or a description of the visual or audio element"
        },
        "rule": {
          "type": "object",
          "required": [
            "ref",
            "summary"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 3,
              "description": "Knowledge base section (countries/us/legal.md#defamation) or official URL"
            },
            "summary": {
              "type": "string",
              "minLength": 10
            }
          }
        },
        "scenario": {
          "type": "string",
          "minLength": 10,
          "description": "Who could do what: lawsuit, fine, strike, removal, demonetization, reach limit"
        },
        "fix": {
          "type": "string",
          "minLength": 5,
          "description": "Concrete rewording or action; 'none' only for low severity"
        },
        "fix_owner": {
          "enum": [
            "script",
            "video",
            "editor",
            "none"
          ]
        }
      }
    },
    "disclosure": {
      "type": "object",
      "required": [
        "scope",
        "what"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 2,
          "description": "Platform or jurisdiction that requires it"
        },
        "what": {
          "type": "string",
          "minLength": 5,
          "description": "Flag, label or text, and where it goes"
        },
        "ref": {
          "type": "string"
        }
      }
    }
  }
}
