# Postgres connection settings for local development (deploy/docker-compose.yml).
# Copy to .env and adjust if needed: cp .env.example .env
POSTGRES_USER=8bitnews
POSTGRES_PASSWORD=8bitnews
POSTGRES_DB=8bitnews
POSTGRES_PORT=5432

# S3-compatible object store for local development (deploy/docker-compose.yml).
# In production, point HUB_S3_* at any S3-compatible provider instead.
HUB_S3_PORT=9000

# hub (cmd/hub): migrate, sync-profiles, serve.
# Postgres DSN understood by pgx; defaults match the compose settings above.
HUB_DATABASE_URL=postgres://8bitnews:8bitnews@localhost:5432/8bitnews?sslmode=disable
# Repository root containing channels/ and countries/, read by sync-profiles.
HUB_REPO_ROOT=.
# Address `hub serve` listens on.
HUB_HTTP_ADDR=:8080
# Comma-separated bearer tokens accepted by REST and MCP (task E1 §4).
HUB_API_KEYS=dev-local-key

# S3-compatible object store for release media.
HUB_S3_ENDPOINT=http://localhost:9000
HUB_S3_REGION=us-east-1
HUB_S3_BUCKET=8bitnews-media
HUB_S3_ACCESS_KEY=8bitnews
HUB_S3_SECRET_KEY=8bitnews-secret
HUB_S3_USE_PATH_STYLE=true
HUB_S3_PRESIGN_EXPIRY=15m

# Wayback Machine Save Page Now endpoint; override in tests to point at an
# httptest server instead of the real archive.org.
HUB_WAYBACK_BASE_URL=https://web.archive.org
# Wayback Availability JSON API endpoint, used to find an existing snapshot
# of a source the hub cannot reach live right now; override in tests.
HUB_WAYBACK_AVAILABILITY_BASE_URL=https://archive.org
# Optional Save Page Now API credentials (archive.org account). Anonymous
# Save Page Now calls are subject to tight rate limits; set these in
# production. Leave empty for anonymous calls.
HUB_WAYBACK_ACCESS_KEY=
HUB_WAYBACK_SECRET_KEY=

# Timeout for each individual outbound HTTP call release_submit's source
# checking/archiving makes (one link check, one Save Page Now call, one
# availability lookup).
HUB_SOURCE_CHECK_TIMEOUT=15s
# SSRF protection for internal/sources: by default it refuses to connect to
# loopback/private/link-local/CGNAT addresses, since the URLs it fetches
# come from research dossiers written after reading untrusted pages. Only
# ever set this to true in tests that point it at an httptest server.
HUB_SOURCE_ALLOW_PRIVATE=false
# How many source links release_submit checks/archives in parallel.
HUB_SOURCES_CONCURRENCY=8
# Overall deadline for release_submit's synchronous source-checking phase
# (all sources' link checks, plus the Save-Page-Now/availability calls
# needed to decide pass/fail for sources that are not live), regardless of
# how many sources there are.
HUB_SOURCES_CHECK_DEADLINE=25s
# Timeout for the background job that archives live ("ok") sources via
# Save Page Now after a release has already been created.
HUB_SOURCES_BACKGROUND_ARCHIVE_TIMEOUT=5m

# If set, /metrics is served unauthenticated on this separate address
# instead of on the main API's authenticated /metrics route — for
# deployments that scrape Prometheus metrics from a private network
# interface. Leave empty to require the API key on /metrics instead.
HUB_METRICS_ADDR=
